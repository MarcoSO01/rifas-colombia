# OPCIONAL: si este archivo no existe, el bot usa las claves de ../.env.local
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Pausa al azar entre mensajes (segundos) y tope por hora — anti-bloqueo
MIN_DELAY_SECONDS=8
MAX_DELAY_SECONDS=20
MAX_PER_HOUR=60
# Mensajes más viejos que esto no se envían (horas)
MAX_AGE_HOURS=48
# Opcional: usar tu Chrome instalado
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
