# ── Supabase → Project Settings → API Keys ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clave pública (publishable "sb_publishable_..." o la legacy "anon")
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Clave SECRETA ("sb_secret_..." o la legacy "service_role"). ¡Nunca la compartas!
# Necesaria para comprar sin registro, consultar números y enviar WhatsApp.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# URL pública del sitio (en Vercel: https://tu-app.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Valores por defecto (se pueden cambiar en Admin → Contenido)
NEXT_PUBLIC_ADMIN_WHATSAPP=3001234567
NEXT_PUBLIC_BRAND_NAME=RifaYa

# Cualquier texto aleatorio (anti-abuso)
RATE_LIMIT_SALT=cambia-esto-por-algo-aleatorio

# ── Cómo se envían los WhatsApp ──────────────────────────────────────
# bot    = el bot de la carpeta /bot envía los mensajes desde tu PC (gratis, no oficial)
# (vacío)= modo asistido, o la API oficial si llenas WHATSAPP_TOKEN
WHATSAPP_PROVIDER=bot

# ── WhatsApp Business Cloud API (OPCIONAL) ───────────────────────────
# Si lo dejas vacío, la app usa el "modo asistido" (botones que abren WhatsApp).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANG=es
WHATSAPP_API_VERSION=v23.0

# ── Publicar directo en tu PÁGINA de Facebook (OPCIONAL) ──────────────
# Sin esto, el botón Facebook abre la ventana de compartir con vista previa.
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
